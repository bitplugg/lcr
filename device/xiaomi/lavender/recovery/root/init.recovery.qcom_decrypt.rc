# LCR (Lavender Custom Recovery) - QCOM decryption services
# Starts the QSEE / Keymaster / Gatekeeper stack used to decrypt /data (FBE/FDE).

service qseecomd /system/bin/qseecomd
    class main
    user root
    group root system
    seclabel u:r:recovery:s0

service vendor.keymaster-4-0 /system/bin/android.hardware.keymaster@4.0-service-qti
    class main
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib
    seclabel u:r:recovery:s0

service vendor.gatekeeper-1-0 /system/bin/android.hardware.gatekeeper@1.0-service-qti
    class main
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib
    seclabel u:r:recovery:s0
